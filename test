-- ==========================================
-- CLEANUP MANAGER
-- ==========================================

local CleanupManager = {
    Connections = {},
    Instances = {},
    CustomCleanups = {},
    IsRunning = true
}

function CleanupManager:AddConn(name, connection)
    if not connection then
        return
    end

    if self.Connections[name] then
        pcall(function()
            self.Connections[name]:Disconnect()
        end)
    end

    self.Connections[name] = connection
end

function CleanupManager:AddInstance(name, instance)
    if not instance then
        return
    end

    if self.Instances[name] then
        pcall(function()
            self.Instances[name]:Destroy()
        end)
    end

    self.Instances[name] = instance
end

function CleanupManager:AddCustomCleanup(cleanupFunction)
    if type(cleanupFunction) == "function" then
        table.insert(self.CustomCleanups, cleanupFunction)
    end
end

function CleanupManager:CleanAll()
    if not self.IsRunning then
        return
    end

    self.IsRunning = false

    for _, connection in pairs(self.Connections) do
        pcall(function()
            connection:Disconnect()
        end)
    end

    for _, instance in pairs(self.Instances) do
        pcall(function()
            instance:Destroy()
        end)
    end

    for _, cleanupFunction in ipairs(self.CustomCleanups) do
        pcall(cleanupFunction)
    end

    table.clear(self.Connections)
    table.clear(self.Instances)
    table.clear(self.CustomCleanups)
end

CleanupManager:AddConn(
    "ScriptDestroying",
    script.Destroying:Connect(function()
        CleanupManager:CleanAll()
    end)
)

