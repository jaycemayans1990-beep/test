-- ==========================================
-- 1. CLEANUP MANAGER (Lifecycle Control)
-- ==========================================
local CleanupManager = {
    Connections = {},
    Instances = {},
    CustomCleanups = {},
    IsRunning = true
}

function CleanupManager:AddConn(name, conn)
    if self.Connections[name] then self.Connections[name]:Disconnect() end
    self.Connections[name] = conn
end

function CleanupManager:AddInstance(name, inst)
    if self.Instances[name] then self.Instances[name]:Destroy() end
    self.Instances[name] = inst
end

function CleanupManager:AddCustomCleanup(func)
    table.insert(self.CustomCleanups, func)
end

function CleanupManager:CleanAll()
    self.IsRunning = false 
    
    for _, conn in pairs(self.Connections) do conn:Disconnect() end
    for _, inst in pairs(self.Instances) do inst:Destroy() end
    for _, func in ipairs(self.CustomCleanups) do pcall(func) end
    
    table.clear(self.Connections)
    table.clear(self.Instances)
    table.clear(self.CustomCleanups)
end

script.Destroying:Connect(function()
    CleanupManager:CleanAll()
end)

