local State = {
    Aimbot = false,
    TeamCheck = true,
    WallCheck = false,
    Prediction = true,
    GravityCompensation = true,

    TargetPartMode = "Head",
    PingCompensation = false,
    DropIsMultiplier = false,

    AutoBulletSpeed = true,
    BulletSpeed = 5000,
    BulletGravity = 0,

    Smoothness = 0.3,
    FOV = 150,

    ShowFOV = false,

    ESP = false,
    ESPName = false
}

local function getCamera()
    return Workspace.CurrentCamera
end

local function getPing()
    if not LocalPlayer then return 0.025 end
    local success, ping = pcall(function() return LocalPlayer:GetNetworkPing() end)
    if success and type(ping) == "number" then
        return math.clamp(ping / 2, 0, 0.5)
    end
    return 0.025
end

-- ==========================================
-- VISIBILITY & TARGET SERVICES
-- ==========================================

local VisibilityService = {}
local sharedRaycast = RaycastParams.new()
sharedRaycast.FilterType = Enum.RaycastFilterType.Exclude
sharedRaycast.IgnoreWater = true

function VisibilityService:GetBaseFilter()
    local filter = {}
    if LocalPlayer.Character then table.insert(filter, LocalPlayer.Character) end
    return filter
end

function VisibilityService:CheckVisibility(targetCharacter, pierceCount, targetPart)
    if not targetCharacter or not targetCharacter.Parent then return false end
    local camera = getCamera()
    if not camera then return false end

    targetPart = targetPart or targetCharacter:FindFirstChild("Head") or targetCharacter:FindFirstChild("HumanoidRootPart")
    if not targetPart or not targetPart:IsA("BasePart") or not targetPart.Parent then return false end

    local targetPosition = targetPart.Position
    local currentOrigin = camera.CFrame.Position
    local dynamicFilter = self:GetBaseFilter()
    local maxPierces = math.max(math.floor(tonumber(pierceCount) or 1), 1)

    for _ = 1, maxPierces do
        local direction = targetPosition - currentOrigin
        if direction.Magnitude <= 0.01 then return true end

        sharedRaycast.FilterDescendantsInstances = dynamicFilter
        local result = Workspace:Raycast(currentOrigin, direction, sharedRaycast)
        if not result then return true end

        local hitPart = result.Instance
        if hitPart:IsDescendantOf(targetCharacter) then return true end

        local canIgnore = hitPart.Transparency >= 0.8 or not hitPart.CanCollide
        if maxPierces > 1 and canIgnore then
            table.insert(dynamicFilter, hitPart)
            local remainingDirection = targetPosition - result.Position
            if remainingDirection.Magnitude <= 0.01 then return true end
            currentOrigin = result.Position + remainingDirection.Unit * 0.05
        else
            return false
        end
    end
    return false
end

local function isValidEnemy(player)
    if not player or player == LocalPlayer or not player.Character then return false end
    local character = player.Character
    local humanoid = character:FindFirstChildOfClass("Humanoid")
    local rootPart = character:FindFirstChild("HumanoidRootPart")

    if not humanoid or humanoid.Health <= 0 or not rootPart then return false end
    if character:FindFirstChildOfClass("ForceField") then return false end
    if State.TeamCheck and player.Team and LocalPlayer.Team and player.Team == LocalPlayer.Team then return false end
    return true
end

local TargetService = { CurrentTarget = nil, TargetPart = nil }

function TargetService:GetTargetPart(character)
    if not character then return nil end
    local rootPart = character:FindFirstChild("HumanoidRootPart")
    if State.TargetPartMode == "Head" then
        return character:FindFirstChild("Head") or rootPart
    end
    return rootPart
end

function TargetService:ReleaseTarget()
    self.CurrentTarget = nil
    self.TargetPart = nil
end

function TargetService:KeepTarget(camera, screenCenter)
    local target = self.CurrentTarget
    local targetPart = self.TargetPart
    if not isValidEnemy(target) then return false end
    if not targetPart or not targetPart:IsA("BasePart") or not targetPart.Parent or not targetPart:IsDescendantOf(target.Character) then return false end
    
    if State.WallCheck then
        if not VisibilityService:CheckVisibility(target.Character, 1, targetPart) then return false end
    end

    local screenPoint, onScreen = camera:WorldToViewportPoint(targetPart.Position)
    if not onScreen or screenPoint.Z <= 0 then return false end
    if (Vector2.new(screenPoint.X, screenPoint.Y) - screenCenter).Magnitude > State.FOV * 1.2 then return false end

    return true
end

function TargetService:AcquireTarget(camera, screenCenter)
    local closestPlayer, closestPart = nil, nil
    local shortestDistance = math.max(tonumber(State.FOV) or 150, 1)

    for _, player in ipairs(Players:GetPlayers()) do
        if isValidEnemy(player) then
            local character = player.Character
            local targetPart = self:GetTargetPart(character)
            if targetPart then
                local visible = true
                if State.WallCheck then
                    visible = VisibilityService:CheckVisibility(character, 1, targetPart)
                end
                if visible then
                    local screenPoint, onScreen = camera:WorldToViewportPoint(targetPart.Position)
                    if onScreen and screenPoint.Z > 0 then
                        local dist = (Vector2.new(screenPoint.X, screenPoint.Y) - screenCenter).Magnitude
                        if dist < shortestDistance then
                            shortestDistance = dist
                            closestPlayer = player
                            closestPart = targetPart
                        end
                    end
                end
            end
        end
    end
    if closestPlayer and closestPart then
        self.CurrentTarget = closestPlayer
        self.TargetPart = closestPart
    end
end

local function getPredictedPosition(targetPart, rootPart)
    if not targetPart or not rootPart then return nil end
    local camera = getCamera()
    if not camera then return targetPart.Position end
    local targetPosition = targetPart.Position
    if not State.Prediction then return targetPosition end

    local bulletSpeed = 3000 -- Fallback speed
    local distance = (targetPosition - camera.CFrame.Position).Magnitude
    local flightTime = math.clamp(distance / bulletSpeed, 0, 5)
    local velocity = rootPart.AssemblyLinearVelocity

    if velocity.Magnitude > 0.5 then
        targetPosition += velocity * flightTime
        if State.PingCompensation then
            targetPosition += velocity * math.clamp(getPing(), 0, 0.5)
        end
    end
    return targetPosition
end

-- ==========================================
-- ESP SERVICE
-- ==========================================

local ESPService = { Cache = {}, COLOR_VISIBLE = Color3.fromRGB(0, 255, 128), COLOR_OBSTRUCTED = Color3.fromRGB(255, 50, 50) }

function ESPService:AddPlayer(player)
    if not player or player == LocalPlayer then return end
    local data = { Character = nil, Highlight = nil, NameTag = nil, Visible = false, LastCheck = 0, Conn = nil }
    self.Cache[player] = data

    local function setupESP(character)
        if not character or not character.Parent then return end
        if data.Highlight then data.Highlight:Destroy() end
        if data.NameTag then data.NameTag:Destroy() end
        
        data.Character = character
        local highlight = Instance.new("Highlight")
        highlight.FillTransparency = 0.5
        highlight.OutlineTransparency = 0
        highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
        highlight.FillColor = self.COLOR_OBSTRUCTED
        highlight.Enabled = State.ESP and isValidEnemy(player)
        highlight.Parent = character
        data.Highlight = highlight

        task.spawn(function()
            local head = character:WaitForChild("Head", 5)
            if head then
                local nameTag = Instance.new("BillboardGui")
                nameTag.Size = UDim2.fromOffset(150, 30)
                nameTag.StudsOffset = Vector3.new(0, 2, 0)
                nameTag.AlwaysOnTop = true
                nameTag.Enabled = State.ESPName and isValidEnemy(player)
                
                local label = Instance.new("TextLabel", nameTag)
                label.Size = UDim2.fromScale(1, 1)
                label.BackgroundTransparency = 1
                label.Text = player.Name
                label.TextColor3 = self.COLOR_OBSTRUCTED
                label.Font = Enum.Font.SourceSansBold
                label.TextSize = 14
                
                nameTag.Adornee = head
                nameTag.Parent = character
                data.NameTag = nameTag
            end
        end)
    end

    if player.Character then setupESP(player.Character) end
    data.Conn = player.CharacterAdded:Connect(setupESP)
end

function ESPService:UpdateState()
    for player, data in pairs(self.Cache) do
        local valid = isValidEnemy(player)
        if data.Highlight then data.Highlight.Enabled = State.ESP and valid end
        if data.NameTag then data.NameTag.Enabled = State.ESPName and valid end
    end
end

function ESPService:ProcessOcclusion()
    if not State.ESP and not State.ESPName then return end
    local ct = os.clock()
    for player, data in pairs(self.Cache) do
        local char = data.Character
        if char and char.Parent and isValidEnemy(player) and ct - data.LastCheck >= 0.35 then
            local root = char:FindFirstChild("HumanoidRootPart")
            if root then
                data.Visible = VisibilityService:CheckVisibility(char, 5, root)
                data.LastCheck = ct
                local col = data.Visible and self.COLOR_VISIBLE or self.COLOR_OBSTRUCTED
                if data.Highlight then data.Highlight.FillColor = col end
                if data.NameTag and data.NameTag:FindFirstChild("TextLabel") then
                    data.NameTag.TextLabel.TextColor3 = col
                end
            end
        end
    end
end

for _, p in ipairs(Players:GetPlayers()) do ESPService:AddPlayer(p) end
CleanupManager:AddConn("ESP_Added", Players.PlayerAdded:Connect(function(p) ESPService:AddPlayer(p) end))
CleanupManager:AddConn("ESP_Removed", Players.PlayerRemoving:Connect(function(p) 
    if ESPService.Cache[p] then
        if ESPService.Cache[p].Conn then ESPService.Cache[p].Conn:Disconnect() end
        if ESPService.Cache[p].Highlight then ESPService.Cache[p].Highlight:Destroy() end
        if ESPService.Cache[p].NameTag then ESPService.Cache[p].NameTag:Destroy() end
        ESPService.Cache[p] = nil
    end
end))

task.spawn(function()
    while CleanupManager.IsRunning do
        task.wait(0.15)
        ESPService:ProcessOcclusion()
    end
end)

