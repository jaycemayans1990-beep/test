-- CACHED LERP SPEED — avoid math.clamp every frame
local function getCamera() return Workspace.CurrentCamera end
local _cachedLerpSpeed = 0.3 * 35
local _lastSmoothness = 0.3

-- WALLCHECK THROTTLE — run raycast every N frames to avoid per-frame raycast cost
local _wallcheckFrame = 0
local _wallcheckThrottle = 4  -- every 4 frames (~15fps effective for wallcheck)
local _cachedTargetVisible = {} -- [player] = bool

local function invalidateWallCache(player)
    _cachedTargetVisible[player] = nil
end

local function needsWallCheck(player)
    _wallcheckFrame = _wallcheckFrame + 1
    if _wallcheckFrame % _wallcheckThrottle == 0 then
        _cachedTargetVisible[player] = nil
    end
    if _cachedTargetVisible[player] == nil and player and player.Character then
        _cachedTargetVisible[player] = VisibilityService:CheckVisibility(player.Character, 1)
    end
    return _cachedTargetVisible[player] or false
end

local function getPing()
    if not LocalPlayer then return 0 end
    local success, ping = pcall(function() return LocalPlayer:GetNetworkPing() end)
    return (success and type(ping) == "number") and (ping / 2) or 0.025
end

