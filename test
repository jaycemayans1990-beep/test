-- 8. EVENT-DRIVEN ESP SERVICE (Optimized)
-- ==========================================
local ESPService = {
    Cache = {},
    COLOR_VISIBLE = Color3.fromRGB(0, 255, 128),
    COLOR_OBSTRUCTED = Color3.fromRGB(255, 50, 50)
}

function ESPService:AddPlayer(player)
    if player == LocalPlayer then return end
    if self.Cache[player] then self:RemovePlayer(player) end

    self.Cache[player] = {
        Character = nil,
        Highlight = nil,
        NameTag = nil,
        Visible = false,
        LastCheck = 0,
        CharConn = nil
    }

    local function onCharAdded(char)
        self:SetupCharacterESP(player, char)
    end

    if player.Character then onCharAdded(player.Character) end
    self.Cache[player].CharConn = player.CharacterAdded:Connect(onCharAdded)
end

function ESPService:SetupCharacterESP(player, char)
    local data = self.Cache[player]
    if not data then return end
    
    if data.Highlight then data.Highlight:Destroy() end
    if data.NameTag then data.NameTag:Destroy() end
    
    data.Character = char
    data.LastCheck = 0
    data.Visible = false
    
    local hl = Instance.new("Highlight")
    hl.Name = "ESP_Highlight"
    hl.FillTransparency = 0.25
    hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    hl.FillColor = self.COLOR_OBSTRUCTED
    hl.OutlineColor = Color3.fromRGB(100, 0, 0)
    hl.Enabled = State.ESP and isValidEnemy(player)
    hl.Parent = char
    data.Highlight = hl

    task.spawn(function()
        local head = char:WaitForChild("Head", 5)
        if head and data.Character == char then
            local nt = Instance.new("BillboardGui")
            nt.Name = "ESP_NameTag"
            nt.Adornee = head
            nt.Size = UDim2.new(0, 150, 0, 30)
            nt.StudsOffset = Vector3.new(0, 2, 0)
            nt.AlwaysOnTop = true
            
            local textLabel = Instance.new("TextLabel")
            textLabel.Name = "TagLabel"
            textLabel.Size = UDim2.new(1, 0, 1, 0)
            textLabel.BackgroundTransparency = 1
            textLabel.TextStrokeTransparency = 0
            textLabel.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
            textLabel.Font = Enum.Font.SourceSansBold
            textLabel.TextSize = 14
            textLabel.Text = player.Name
            textLabel.TextColor3 = self.COLOR_OBSTRUCTED
            textLabel.Parent = nt

            nt.Enabled = State.ESPName and isValidEnemy(player)
            nt.Parent = char
            data.NameTag = nt
        end
    end)
end

function ESPService:UpdateState()
    for player, data in pairs(self.Cache) do
        local valid = isValidEnemy(player)
        if data.Highlight then
            data.Highlight.Enabled = State.ESP and valid
        end
        if data.NameTag then
            data.NameTag.Enabled = State.ESPName and valid
        end
    end
end

function ESPService:RemovePlayer(player)
    local data = self.Cache[player]
    if data then
        if data.CharConn then data.CharConn:Disconnect() end
        if data.Highlight then data.Highlight:Destroy() end
        if data.NameTag then data.NameTag:Destroy() end
        self.Cache[player] = nil
    end
end

function ESPService:ClearAll()
    for player, _ in pairs(self.Cache) do
        self:RemovePlayer(player)
    end
end
CleanupManager:AddCustomCleanup(function() ESPService:ClearAll() end)

CleanupManager:AddConn("PlayerAddedESP", Players.PlayerAdded:Connect(function(player)
    ESPService:AddPlayer(player)
end))
CleanupManager:AddConn("PlayerRemovingESP", Players.PlayerRemoving:Connect(function(player)
    ESPService:RemovePlayer(player)
end))

for _, player in ipairs(Players:GetPlayers()) do
    ESPService:AddPlayer(player)
end

function ESPService:ProcessOcclusion()
    if not State.ESP and not State.ESPName then return end
    
    local now = os.clock()
    for player, data in pairs(self.Cache) do
        local char = data.Character
        if not char or not isValidEnemy(player) then continue end
        
        if now - data.LastCheck > 0.35 then
            data.Visible = VisibilityService:CheckVisibility(char, 5)
            data.LastCheck = now
            
            local currentColor = data.Visible and self.COLOR_VISIBLE or self.COLOR_OBSTRUCTED
            local outlineColor = data.Visible and Color3.fromRGB(255, 215, 0) or Color3.fromRGB(100, 0, 0)
            
            if data.Highlight and State.ESP then
                data.Highlight.FillColor = currentColor
                data.Highlight.OutlineColor = outlineColor
            end
            if data.NameTag and State.ESPName then
                data.NameTag.TagLabel.TextColor3 = currentColor
            end
        end
    end
end

task.spawn(function()
    while CleanupManager.IsRunning do 
        task.wait(0.15)
        ESPService:ProcessOcclusion() 
    end
end)

-- ==========================================
-- 9. CAMERA MANIPULATION ENGINE (BindToRenderStep)
-- ==========================================
local CAMERA_BIND_NAME = "SnyX_CameraUpdate"

CleanupManager:AddCustomCleanup(function()
    RunService:UnbindFromRenderStep(CAMERA_BIND_NAME)
end)

-- ใช้ BindToRenderStep และเซ็ต Priority ไว้หลัง Camera (+1) เพื่อป้องกันเกมเขียนทับกลับจนเกิดอาการสั่น
RunService:BindToRenderStep(CAMERA_BIND_NAME, Enum.RenderPriority.Camera.Value + 1, function(deltaTime)
    local camera = getCamera()
    if not camera then return end

    local viewport = camera.ViewportSize
    local screenCenter = Vector2.new(viewport.X / 2, viewport.Y / 2)
    
    FOVCircle.Position = UDim2.fromOffset(screenCenter.X, screenCenter.Y)
    FOVCircle.Size = UDim2.fromOffset(State.FOV * 2, State.FOV * 2)
    FOVCircle.Visible = State.ShowFOV

    if not State.Aimbot then
        TargetService:ReleaseTarget()
        return
    end

    if TargetService.CurrentTarget then
        if not TargetService:KeepTarget(camera, screenCenter) then
            TargetService:ReleaseTarget()
        end
    end

    if not TargetService.CurrentTarget then
        TargetService:AcquireTarget(camera, screenCenter)
    end

    if TargetService.CurrentTarget and TargetService.TargetPart then
        local rootPart = TargetService.CurrentTarget.Character:FindFirstChild("HumanoidRootPart")
        if rootPart then
            local targetPos = getPredictedPosition(TargetService.TargetPart, rootPart)
            local targetCFrame = CFrame.lookAt(camera.CFrame.Position, targetPos)
            local lerpSpeed = math.clamp(State.Smoothness * 35, 1, 60)
            local alpha = 1 - math.exp(-lerpSpeed * deltaTime)
            camera.CFrame = camera.CFrame:Lerp(targetCFrame, alpha)
        end
    end
end)

