-- ==========================================
-- MAIN LOOP (AIMBOT & RENDER)
-- ==========================================

local isAiming = false

CleanupManager:AddConn("AimKey_Down", UserInputService.InputBegan:Connect(function(input, gp)
    if not gp and input.UserInputType == Enum.UserInputType.MouseButton2 then
        isAiming = true
    end
end))

CleanupManager:AddConn("AimKey_Up", UserInputService.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton2 then
        isAiming = false
        TargetService:ReleaseTarget()
    end
end))

CleanupManager:AddConn("MainRenderLoop", RunService.RenderStepped:Connect(function()
    if not CleanupManager.IsRunning then return end
    local camera = Workspace.CurrentCamera
    if not camera then return end

    local viewportSize = camera.ViewportSize
    local screenCenter = Vector2.new(viewportSize.X / 2, viewportSize.Y / 2)

    -- อัปเดต FOV Circle
    if State.ShowFOV then
        FOVCircle.Visible = true
        FOVCircle.Position = UDim2.fromOffset(screenCenter.X, screenCenter.Y)
        FOVCircle.Size = UDim2.fromOffset(State.FOV * 2, State.FOV * 2)
    else
        FOVCircle.Visible = false
    end

    -- ประมวลผล Aimbot
    if not State.Aimbot or not isAiming then
        TargetService:ReleaseTarget()
        return
    end

    if TargetService.CurrentTarget then
        if not TargetService:KeepTarget(camera, screenCenter) then
            TargetService:ReleaseTarget()
        end
    end

    if not TargetService.CurrentTarget then
        TargetService:AcquireTarget(camera, screenCenter)
    end

    local target = TargetService.CurrentTarget
    local targetPart = TargetService.TargetPart

    if target and targetPart then
        local rootPart = target.Character and target.Character:FindFirstChild("HumanoidRootPart")
        if rootPart then
            local predictedPos = getPredictedPosition(targetPart, rootPart)
            if predictedPos then
                local currentCFrame = camera.CFrame
                local targetCFrame = CFrame.new(currentCFrame.Position, predictedPos)
                -- ใช้ค่า Smoothness ปรับความสมูทในการหันกล้อง (0 = แข็ง, 1 = ช้ามาก)
                camera.CFrame = currentCFrame:Lerp(targetCFrame, State.Smoothness)
            end
        end
    end
end))
