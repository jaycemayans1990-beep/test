-- ==========================================
-- WEAPON SERVICE
-- ==========================================

local WeaponService = {
    Speed = 3000,
    Gravity = Workspace.Gravity
}

local function getNumberFromConfig(config, keys)
    if type(config) ~= "table" then
        return nil
    end

    for _, key in ipairs(keys) do
        local value = config[key]

        if type(value) == "number" and value > 0 then
            return value
        end
    end

    return nil
end

function WeaponService:UpdateManual()
    if State.AutoBulletSpeed then
        return
    end

    self.Speed = math.max(
        tonumber(State.BulletSpeed) or 1,
        1
    )

    local gravity = tonumber(State.BulletGravity)

    if gravity and gravity >= 0 then
        self.Gravity = gravity
    else
        self.Gravity = Workspace.Gravity
    end
end

function WeaponService:UpdateAuto()
    if not State.AutoBulletSpeed then
        self:UpdateManual()
        return
    end

    local character = LocalPlayer.Character
    local tool = character and character:FindFirstChildOfClass("Tool")

    if not tool then
        self.Speed = math.max(
            tonumber(State.BulletSpeed) or 3000,
            1
        )

        self.Gravity = Workspace.Gravity
        return
    end

    local toolName = string.lower(tool.Name)

    local isLauncher =
        string.find(toolName, "rpg", 1, true)
        or string.find(toolName, "rocket", 1, true)
        or string.find(toolName, "launcher", 1, true)
        or string.find(toolName, "grenade", 1, true)

    local settings =
        tool:FindFirstChild("ACS_Settings")
        or tool:FindFirstChild("Settings")
        or tool:FindFirstChild("Config")

    if settings and settings:IsA("ModuleScript") then
        local success, config = pcall(require, settings)

        if success and type(config) == "table" then
            local speed = getNumberFromConfig(config, {
                "Velo",
                "MuzzleVelocity",
                "BulletSpeed",
                "Velocity",
                "ProjectileSpeed"
            })

            self.Speed = speed or math.max(
                tonumber(State.BulletSpeed) or 3000,
                1
            )

            local drop =
                config.Drop
                or config.BulletDrop
                or config.Gravity

            if type(drop) == "number" and drop >= 0 then
                if State.DropIsMultiplier then
                    self.Gravity = Workspace.Gravity * drop
                else
                    self.Gravity = drop
                end
            else
                self.Gravity = Workspace.Gravity
            end

            return
        end
    end

    self.Speed = math.max(
        tonumber(State.BulletSpeed) or 3000,
        1
    )

    self.Gravity = Workspace.Gravity

    if isLauncher and not string.find(toolName, "grenade", 1, true) then
        self.Gravity = 0
    end
end

local function setupCharacterWeaponListener(character)
    if not character then
        return
    end

    CleanupManager:AddConn(
        "ToolAdded",
        character.ChildAdded:Connect(function(child)
            if child:IsA("Tool") then
                task.defer(function()
                    if CleanupManager.IsRunning then
                        WeaponService:UpdateAuto()
                    end
                end)
            end
        end)
    )

    CleanupManager:AddConn(
        "ToolRemoved",
        character.ChildRemoved:Connect(function(child)
            if child:IsA("Tool") then
                task.defer(function()
                    if CleanupManager.IsRunning then
                        WeaponService:UpdateAuto()
                    end
                end)
            end
        end)
    )

    WeaponService:UpdateAuto()
end

if LocalPlayer.Character then
    setupCharacterWeaponListener(LocalPlayer.Character)
end

CleanupManager:AddConn(
    "CharacterAdded",
    LocalPlayer.CharacterAdded:Connect(function(character)
        setupCharacterWeaponListener(character)
    end)
