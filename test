-- ==========================================
-- 4. VISIBILITY SERVICE (Immutable Raycast)
-- ==========================================
local VisibilityService = {}
local sharedRaycast = RaycastParams.new()
sharedRaycast.FilterType = Enum.RaycastFilterType.Exclude
sharedRaycast.IgnoreWater = true

function VisibilityService:GetBaseFilter()
    local filter = {}
    if LocalPlayer.Character then table.insert(filter, LocalPlayer.Character) end
    return filter
end

function VisibilityService:CheckVisibility(targetCharacter, pierceCount)
    if not targetCharacter then return false end
    local camera = getCamera()
    if not camera then return false end

    local targetPart = targetCharacter:FindFirstChild("Head") or targetCharacter:FindFirstChild("HumanoidRootPart")
    if not targetPart then return false end

    local origin = camera.CFrame.Position
    local targetPos = targetPart.Position
    local currentOrigin = origin
    local currentDirection = targetPos - origin
    
    local dynamicFilter = self:GetBaseFilter()
    local maxPierces = pierceCount or 1 

    for i = 1, maxPierces do
        sharedRaycast.FilterDescendantsInstances = dynamicFilter
        local result = Workspace:Raycast(currentOrigin, currentDirection, sharedRaycast)
        
        if not result then return true end

        local hitPart = result.Instance
        if hitPart:IsDescendantOf(targetCharacter) then return true end

        if maxPierces > 1 and (hitPart.Transparency > 0.8 or not hitPart.CanCollide) then
            table.insert(dynamicFilter, hitPart)
            currentDirection = targetPos - result.Position
            currentOrigin = result.Position + (currentDirection.Unit * 0.05)
        else
            return false
        end
    end
    return false
end

local function isValidEnemy(player)
    if not player or player == LocalPlayer or not player.Character then return false end
    local humanoid = player.Character:FindFirstChildOfClass("Humanoid")
    local rootPart = player.Character:FindFirstChild("HumanoidRootPart")
    if not humanoid or not rootPart or humanoid.Health <= 0 then return false end
    if player.Character:FindFirstChildOfClass("ForceField") then return false end
    if State.TeamCheck and player.Team and LocalPlayer.Team and player.Team == LocalPlayer.Team then return false end
    return true
end

-- ==========================================
-- 5. TARGET SERVICE (State Machine)
-- ==========================================
local TargetService = {
    CurrentTarget = nil,
    TargetPart = nil
}

function TargetService:GetTargetPart(char)
    local root = char:FindFirstChild("HumanoidRootPart")
    if State.TargetPartMode == "Head" then return char:FindFirstChild("Head") or root end
    if State.TargetPartMode == "Random" then 
        local parts = {"Head", "UpperTorso", "LowerTorso", "HumanoidRootPart"}
        local selected = parts[math.random(1, #parts)]
        return char:FindFirstChild(selected) or root
    end
    return root 
end

function TargetService:ReleaseTarget()
    self.CurrentTarget = nil
    self.TargetPart = nil
end

function TargetService:KeepTarget(camera, screenCenter)
    -- Fast path: reuse previously cached visibility if still fresh
    local ct = self.CurrentTarget
    if not ct or not ct.Character then return false end
    local char = ct.Character
    if not char:FindFirstChildOfClass("Humanoid") or char:FindFirstChildOfClass("Humanoid").Health <= 0 then return false end

    if State.TeamCheck and ct.Team and LocalPlayer.Team and ct.Team == LocalPlayer.Team then return false end
    if ct.Character:FindFirstChildOfClass("ForceField") then return false end

    -- Throttled wallcheck (runs every 4 frames via needsWallCheck)
    if State.WallCheck and not needsWallCheck(ct) then return false end

    -- Target part may have been destroyed / character may have changed
    if not self.TargetPart or not self.TargetPart.Parent or not self.TargetPart:IsDescendantOf(char) then
        -- Try to refresh target part
        self.TargetPart = self:GetTargetPart(char)
        if not self.TargetPart then return false end
    end

    local sp, onScreen = camera:WorldToViewportPoint(self.TargetPart.Position)
    if not onScreen then return false end

    -- Inline distance (avoids Vector2.new allocation)
    local dx, dy = sp.X - screenCenter.X, sp.Y - screenCenter.Y
    if (dx*dx + dy*dy) > (State.FOV * 1.2) ^ 2 then return false end

    return true
end

function TargetService:AcquireTarget(camera, screenCenter)
    local closestPlayer = nil
    local shortestDist = State.FOV
    local shortestDistSq = State.FOV * State.FOV
    local bestPart = nil
    local fovSq = State.FOV * State.FOV

    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character then
            local humanoid = player.Character:FindFirstChildOfClass("Humanoid")
            if not humanoid or humanoid.Health <= 0 then
            elseif not player.Character:FindFirstChildOfClass("ForceField") then
                if not (State.TeamCheck and player.Team and LocalPlayer.Team and player.Team == LocalPlayer.Team) then
                    local tempPart = self:GetTargetPart(player.Character)
                    if tempPart then
                        if not State.WallCheck or needsWallCheck(player) then
                            local sp, onScreen = camera:WorldToViewportPoint(tempPart.Position)
                            if onScreen then
                                -- Inline distance squared (avoids allocation)
                                local dx, dy = sp.X - screenCenter.X, sp.Y - screenCenter.Y
                                local distSq = dx*dx + dy*dy
                                if distSq < shortestDistSq then
                                    shortestDistSq = distSq
                                    closestPlayer = player
                                    bestPart = tempPart
                                end
                            end
                        end
                    end
                end
            end
        end
    end

    if closestPlayer then
        self.CurrentTarget = closestPlayer
        self.TargetPart = bestPart
        _cachedTargetVisible[closestPlayer] = true
    end
end

-- ==========================================
-- 6. APPROXIMATE PREDICTION ENGINE
-- ==========================================
local function getPredictedPosition(targetPart, rootPart)
    local targetPos = targetPart.Position
    if not State.Prediction then return targetPos end

    local camera = getCamera()
    if not camera then return targetPos end

    local distance = (targetPos - camera.CFrame.Position).Magnitude
    local flightTime = distance / math.max(WeaponService.Speed, 1)
    local velocity = rootPart.AssemblyLinearVelocity

    if velocity.Magnitude > 0.5 then
        targetPos = targetPos + (velocity * flightTime)
        
        if State.PingCompensation then
            local pingOffset = velocity * getPing()
            targetPos = targetPos + pingOffset
        end
    end

    if WeaponService.Gravity > 0 then
        local dropOffset = Vector3.new(0, 0.5 * WeaponService.Gravity * (flightTime ^ 2), 0)
        targetPos = targetPos + dropOffset
    end

    return targetPos
end

