    ESPService.Cache[player] = nil
    _cachedTargetVisible[player] = nil
end))

function ESPService:ProcessESP()
    local now = tick()
    
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character then
            local isEnemy = isValidEnemy(player)
            local char = player.Character
            
            local highlight = char:FindFirstChild("ESP_Highlight")
            local nameTag = char:FindFirstChild("ESP_NameTag")

            -- FIX: replace `continue` with Lua 5.1-compatible early-out
            if not (not State.ESP and not State.ESPName) and isEnemy then
                -- Invalidate Cache หากผู้เล่นเกิดใหม่ (Character เปลี่ยน) หรือเวลาผ่านไปเกิน 0.35 วิ
                if not self.Cache[player] or self.Cache[player].Character ~= char or (now - self.Cache[player].LastCheck > 0.35) then
                    self.Cache[player] = {
                        Character = char,
                        Visible = VisibilityService:CheckVisibility(char, 5),
                        LastCheck = now
                    }
                end
                
                local visible = self.Cache[player].Visible
                local currentColor = visible and self.COLOR_VISIBLE or self.COLOR_OBSTRUCTED

                if State.ESP then
                    if not highlight then
                        highlight = Instance.new("Highlight")
                        highlight.Name = "ESP_Highlight"
                        highlight.FillTransparency = 0.25
                        highlight.Parent = char
                    end
                    highlight.FillColor = currentColor
                    highlight.OutlineColor = visible and Color3.fromRGB(255, 215, 0) or Color3.fromRGB(100, 0, 0)
                end

                if State.ESPName then
                    local head = char:FindFirstChild("Head")
                    if head then
                        if not nameTag then
                            nameTag = Instance.new("BillboardGui")
                            nameTag.Name = "ESP_NameTag"
                            nameTag.Adornee = head
                            nameTag.Size = UDim2.new(0, 150, 0, 30)
                            nameTag.StudsOffset = Vector3.new(0, 2, 0)
                            nameTag.AlwaysOnTop = true
                            nameTag.Parent = char

                            local textLabel = Instance.new("TextLabel")
                            textLabel.Name = "TagLabel"
                            textLabel.Size = UDim2.new(1, 0, 1, 0)
                            textLabel.BackgroundTransparency = 1
                            textLabel.Text = player.Name
                            textLabel.TextStrokeTransparency = 0
                            textLabel.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
                            textLabel.Font = Enum.Font.SourceSansBold
                            textLabel.TextSize = 14
                            textLabel.Parent = nameTag
                        end
                        nameTag.TagLabel.TextColor3 = currentColor
                    end
                end
            end
        end
    end
end

task.spawn(function()
    while getgenv().SnyX_Running and task.wait(0.15) do 
        ESPService:ProcessESP() 
    end
end)

