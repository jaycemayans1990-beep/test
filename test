-- 3. WEAPON SERVICE (Cached Weapon Stats)
-- ==========================================
local WeaponService = {
    Speed = 3000,
    Gravity = workspace.Gravity
}

function WeaponService:UpdateManual()
    if not State.AutoBulletSpeed then
        self.Speed = math.max(State.BulletSpeed or 10000, 1)
        self.Gravity = State.BulletGravity ~= nil and State.BulletGravity or workspace.Gravity
    end
end

function WeaponService:UpdateAuto()
    if not State.AutoBulletSpeed then return self:UpdateManual() end

    local char = LocalPlayer.Character
    local tool = char and char:FindFirstChildOfClass("Tool")
    
    if tool then
        local toolName = tool.Name:lower()
        local isLauncher = toolName:find("rpg") or toolName:find("rocket") or toolName:find("launcher") or toolName:find("grenade")
        local acsSettings = tool:FindFirstChild("ACS_Settings") or tool:FindFirstChild("Settings") or tool:FindFirstChild("Config")
        
        if acsSettings and acsSettings:IsA("ModuleScript") then
            local success, config = pcall(require, acsSettings)
            if success and type(config) == "table" then
                local speed = config.Velo or config.MuzzleVelocity or config.BulletSpeed or config.Velocity
                self.Speed = (type(speed) == "number" and speed > 0) and speed or (State.BulletSpeed or 10000)

                local drop = config.Drop or config.BulletDrop or config.Gravity
                if type(drop) == "number" then
                    self.Gravity = State.DropIsMultiplier and (workspace.Gravity * drop) or drop
                else
                    self.Gravity = (isLauncher and not toolName:find("grenade")) and 0 or workspace.Gravity
                end
                return
            end
        end
    end
    self.Speed = math.max(State.BulletSpeed or 3000, 1)
    self.Gravity = workspace.Gravity
end

local function setupCharacterWeaponListener(char)
    if not char then return end
    CleanupManager:AddConn("ToolAdded", char.ChildAdded:Connect(function(child)
        if child:IsA("Tool") then task.defer(function() WeaponService:UpdateAuto() end) end
    end))
    CleanupManager:AddConn("ToolRemoved", char.ChildRemoved:Connect(function(child)
        if child:IsA("Tool") then task.defer(function() WeaponService:UpdateAuto() end) end
    end))
    WeaponService:UpdateAuto()
end

