-- 8. MAIN CAMERA ENGINE
-- ==========================================
local FOVCircle = Drawing.new("Circle")
FOVCircle.Thickness = 1.5
FOVCircle.Color = Color3.fromRGB(255, 255, 255)
FOVCircle.Filled = false
FOVCircle.Transparency = 0.7
CleanupManager:AddDrawing("FOVCircle", FOVCircle)

local _fovCircleFrame = 0
local _fovCircleVisible = false
CleanupManager:AddConn("RenderStep", RunService.RenderStepped:Connect(function(deltaTime)
    local camera = getCamera()
    if not camera then return end

    -- Throttle FOVCircle drawing (every 6 frames)
    _fovCircleFrame = _fovCircleFrame + 1
    if _fovCircleFrame % 6 == 0 then
        local vs = camera.ViewportSize
        FOVCircle.Position = Vector2.new(vs.X * 0.5, vs.Y * 0.5)
        FOVCircle.Radius = State.FOV
        FOVCircle.Visible = State.ShowFOV
    end

    -- Early exit if aimbot is off
    if not State.Aimbot then
        if TargetService.CurrentTarget then TargetService:ReleaseTarget() end
        return
    end

    -- Keep target or release
    if TargetService.CurrentTarget then
        if not TargetService:KeepTarget(camera, Vector2.new(camera.ViewportSize.X * 0.5, camera.ViewportSize.Y * 0.5)) then
            TargetService:ReleaseTarget()
        end
    end

    -- Acquire if no current target
    if not TargetService.CurrentTarget then
        local vs = camera.ViewportSize
        TargetService:AcquireTarget(camera, Vector2.new(vs.X * 0.5, vs.Y * 0.5))
    end

    -- Apply aim (native camera move — not silent aim, no lag/stutter)
    local ct = TargetService.CurrentTarget
    local tp = TargetService.TargetPart
    if ct and tp and ct.Character then
        local rootPart = ct.Character:FindFirstChild("HumanoidRootPart")
        if rootPart then
            -- Cached lerp speed: only recalc when Smoothness changes
            local sm = State.Smoothness
            if sm ~= _lastSmoothness then
                _lastSmoothness = sm
                _cachedLerpSpeed = math.clamp(sm * 35, 1, 60)
            end

            local targetPos = getPredictedPosition(tp, rootPart)
            local targetCFrame = CFrame.lookAt(camera.CFrame.Position, targetPos)
            -- Smooth lerp using exp decay (frame-rate independent)
            local alpha = 1 - math.exp(-_cachedLerpSpeed * deltaTime)
            camera.CFrame = camera.CFrame:Lerp(targetCFrame, alpha)
        end
    end
end))

